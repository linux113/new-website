# ============================================================
# SRIYAAN METALS — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# MySQL connection string (Prisma + @prisma/adapter-mariadb)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# The database must be utf8mb4 / utf8mb4_unicode_ci.
# Percent-encode any reserved characters in the password (@ : / ? #).
DATABASE_URL=

# Max pooled MySQL connections (default 5). Shared hosting plans cap
# concurrent connections aggressively — lower this if you hit
# "Too many connections".
# DATABASE_CONNECTION_LIMIT=5

# Public site URL (canonical/OG/sitemap generation)
NEXT_PUBLIC_SITE_URL=https://sriyaanmetals.com

# --- Cloudflare R2 / S3-compatible storage (media uploads) ---
# When unset in development, uploads fall back to local filesystem
# (public/uploads). Production REQUIRES these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Email notifications (Resend-compatible HTTP API) ---
# When unset, emails are logged server-side and reported undelivered
# (never faked).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Optional: Cloudflare Turnstile (spam protection upgrade) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- First deploy bootstrap ---
# ADMIN_* create the first admin user (password min 12 chars).
# SEED_CONTENT=1 seeds the catalogue content; remove it and redeploy
# once all content is managed from the admin panel.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# SEED_CONTENT=1

# --- Google Search Console ---
# Ownership verification via the "HTML tag" method. Paste ONLY the
# content="..." token, e.g. GOOGLE_SITE_VERIFICATION=abc123xyz
# The HTML-file method does not work on Next.js (files added to the
# server after `next build` are not served).
GOOGLE_SITE_VERIFICATION=
