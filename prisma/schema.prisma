// ============================================================
// SRIYAAN METALS — Prisma schema (Phase 5)
//
// Database foundation for the public website + future admin panel.
// No business data lives in the schema; all records arrive later
// via the admin panel or clearly-marked development seeds.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL is provided via prisma.config.ts (CLI) and the
// pg driver adapter in src/lib/db.ts (runtime) — both read
// DATABASE_URL from the environment. Never hardcode credentials.
datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

/// Shared lifecycle for public content (categories, products,
/// company content). Blog has its own status with ARCHIVED.
enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  CLOSED
  SPAM
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum ProductRelationType {
  RELATED
  ALTERNATIVE
  ACCESSORY
}

enum ProductDocumentType {
  DATASHEET
  DRAWING
  CATALOGUE
  CERTIFICATE
  OTHER
}

// ============================================================
// SEO (normalized — one table reused by all public entities)
// ============================================================

/// Reusable SEO metadata. Entities reference it 1:1 via seoId.
/// Normalized to avoid duplicated SEO columns on every table.
model SeoMeta {
  id              String      @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageId       String?
  ogImage         MediaAsset? @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  robots          String? // e.g. "index,follow" | "noindex"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  category    Category?
  product     Product?
  blogPost    BlogPost?
  companyPage CompanyPage?

  @@index([ogImageId])
}

// ============================================================
// ADMIN
// ============================================================

model AdminUser {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  /// bcrypt/argon2 hash only — never plaintext (enforced at the
  /// application layer; the column name makes intent explicit).
  passwordHash String
  role         AdminRole   @default(EDITOR)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  blogPosts BlogPost[] @relation("BlogAuthor")

  @@index([status])
}

// ============================================================
// MEDIA (Cloudflare R2 / S3-compatible)
// ============================================================

model MediaAsset {
  id              String    @id @default(cuid())
  /// e.g. "r2", "s3", "local" — provider-agnostic architecture.
  storageProvider String    @default("r2")
  /// Object key within the bucket. Unique per provider.
  storageKey      String
  publicUrl       String?
  filename        String
  mimeType        String
  type            MediaType @default(IMAGE)
  width           Int?
  height          Int?
  /// Bytes.
  size            Int?
  altText         String?
  /// Free-form JSON (EXIF, focal point, duotone flag, etc.)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categoryImages      Category[]
  productImages       ProductImage[]
  productDocuments    ProductDocument[]
  blogFeaturedImages  BlogPost[]           @relation("BlogFeaturedImage")
  seoOgImages         SeoMeta[]            @relation("SeoOgImage")
  infrastructureItems InfrastructureItem[]
  certifications      Certification[]
  customers           Customer[]
  testimonialAvatars  Testimonial[]

  @@unique([storageProvider, storageKey])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// PRODUCT CATALOG
// ============================================================

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  seoId       String?       @unique
  seo         SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products Product[]

  @@index([status, sortOrder])
  @@index([imageId])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  productCode      String?       @unique
  status           ContentStatus @default(DRAFT)
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seoId            String?       @unique
  seo              SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images         ProductImage[]
  specifications ProductSpecification[]
  applications   ProductApplication[]
  documents      ProductDocument[]
  relationsFrom  ProductRelation[]      @relation("RelationSource")
  relationsTo    ProductRelation[]      @relation("RelationTarget")
  enquiries      ProductEnquiry[]

  @@index([categoryId, status])
  @@index([status, featured])
  @@index([status, sortOrder])
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  altText   String?
  sortOrder Int        @default(0)

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  unit      String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductApplication {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  application String
  sortOrder   Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductDocument {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  name      String
  type      ProductDocumentType @default(DATASHEET)
  sortOrder Int                 @default(0)

  @@index([productId, sortOrder])
  @@index([mediaId])
}

/// Directed product↔product association (self-relation).
model ProductRelation {
  id               String              @id @default(cuid())
  sourceProductId  String
  sourceProduct    Product             @relation("RelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product             @relation("RelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relationType     ProductRelationType @default(RELATED)

  @@unique([sourceProductId, relatedProductId, relationType])
  @@index([relatedProductId])
}

// ============================================================
// BLOG
// ============================================================

model BlogCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]

  @@index([sortOrder])
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?
  /// Rich content (markdown or serialized editor state).
  content         String?
  featuredImageId String?
  featuredImage   MediaAsset?   @relation("BlogFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  authorId        String?
  author          AdminUser?    @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          BlogStatus    @default(DRAFT)
  publishedAt     DateTime?
  seoId           String?       @unique
  seo             SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tags BlogPostTag[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([authorId])
  @@index([featuredImageId])
}

model BlogTag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts BlogPostTag[]
}

/// Explicit join table: post ↔ tag (m:n).
model BlogPostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ============================================================
// COMPANY CONTENT (admin-manageable — no seeded business claims)
// ============================================================

/// Static-page content managed from admin (About, Quality intro …).
model CompanyPage {
  id        String        @id @default(cuid())
  key       String        @unique // e.g. "about", "quality"
  title     String
  content   String?
  status    ContentStatus @default(DRAFT)
  seoId     String?       @unique
  seo       SeoMeta?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

/// Capability strip entries (homepage SM–02).
model Capability {
  id           String        @id @default(cuid())
  label        String
  note         String?
  /// Optional verified numeric metric; null → label-only rendering.
  metricValue  Decimal?      @db.Decimal(12, 2)
  metricPrefix String?
  metricSuffix String?
  status       ContentStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Industry {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

/// Manufacturing/infrastructure gallery items (factory, machinery,
/// warehouse, packaging — real client imagery only).
model InfrastructureItem {
  id        String        @id @default(cuid())
  title     String
  caption   String?
  mediaId   String?
  media     MediaAsset?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([mediaId])
}

model Certification {
  id         String        @id @default(cuid())
  name       String
  /// Issuing body, certificate number etc. — only verified data.
  issuer     String?
  documentId String?
  document   MediaAsset?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  validFrom  DateTime?
  validUntil DateTime?
  status     ContentStatus @default(DRAFT)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([documentId])
}

model Customer {
  id        String        @id @default(cuid())
  name      String
  logoId    String?
  logo      MediaAsset?   @relation(fields: [logoId], references: [id], onDelete: SetNull)
  website   String?
  /// Logos are published only with permission.
  consent   Boolean       @default(false)
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  testimonials Testimonial[]

  @@index([status, sortOrder])
  @@index([logoId])
}

model Testimonial {
  id         String        @id @default(cuid())
  quote      String
  personName String
  personRole String?
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  avatarId   String?
  avatar     MediaAsset?   @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  status     ContentStatus @default(DRAFT)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([customerId])
  @@index([avatarId])
}

/// Confirmed export/import markets (Global Reach map). Publishing a
/// row = the client has verified the market.
model GlobalCountry {
  id        String        @id @default(cuid())
  /// ISO 3166-1 alpha-2, lowercase.
  code      String        @unique
  label     String
  /// "import" | "export" | "both"
  direction String        @default("export")
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model ImportExportCapability {
  id          String        @id @default(cuid())
  /// "import" | "export"
  direction   String
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

// ============================================================
// LEADS / ENQUIRIES
// ============================================================

model ProductEnquiry {
  id          String        @id @default(cuid())
  name        String
  company     String?
  email       String
  phone       String?
  whatsapp    String?
  message     String
  /// Quantity / grade / delivery expectations as free text for now.
  requirement String?
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  status      EnquiryStatus @default(NEW)
  /// e.g. "website", "whatsapp", "referral"
  source      String        @default("website")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([productId])
  @@index([email])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  whatsapp  String?
  subject   String?
  message   String
  status    EnquiryStatus @default(NEW)
  source    String        @default("website")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
}

/// Suppliers / vendors proposing material to SRIYAAN METALS.
model VendorRequest {
  id        String        @id @default(cuid())
  name      String
  company   String
  email     String
  phone     String?
  whatsapp  String?
  /// What they supply.
  offering  String
  message   String?
  status    EnquiryStatus @default(NEW)
  source    String        @default("website")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
}

// ============================================================
// WEBSITE SETTINGS
// ============================================================

/// Key-value configuration (contact numbers, hours, GST display,
/// feature flags). Values as JSON for typed flexibility.
model WebsiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  /// Grouping hint for the admin UI, e.g. "contact", "seo", "general".
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

model SocialLink {
  id        String        @id @default(cuid())
  platform  String // "linkedin", "x", "youtube", …
  label     String
  url       String
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([platform])
  @@index([status, sortOrder])
}

/// Admin-manageable navigation (header/footer), hierarchical.
model NavigationItem {
  id        String           @id @default(cuid())
  /// "header" | "footer-company" | "footer-products" | "footer-engage"
  menu      String
  label     String
  href      String
  parentId  String?
  parent    NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavigationItem[] @relation("NavTree")
  status    ContentStatus    @default(PUBLISHED)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([menu, status, sortOrder])
  @@index([parentId])
}
